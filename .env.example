APP_NAME="Haman Planner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Tehran
# Interface language for visitors with no saved/browser preference: fa or en
APP_LOCALE=fa

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=haman_planner
DB_USERNAME=haman_planner
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

PLANNER_ADMIN_NAME=Reza
PLANNER_ADMIN_EMAIL=admin@hamantech.ir
# Strong password, 12+ chars. If omitted, APP_API_TOKEN is used only to bootstrap the first admin password.
PLANNER_ADMIN_PASSWORD=

APP_API_TOKEN=

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public sign-up on /register (true/false)
PLANNER_REGISTRATION=true
# Telegram bot username without @ (enables one-tap link button in account settings)
TELEGRAM_BOT_USERNAME=

# Mail (required for password-reset emails; Telegram-linked users also get the link in the bot)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Haman Planner"

# ---------------------------------------------------------------- business / legal
# Shown on invoices and the Privacy/Terms placeholders. Replace with your registered entity.
LEGAL_ENTITY_NAME=HamanTech
# Public contact address for privacy/support questions (defaults to MAIL_FROM_ADDRESS)
SUPPORT_EMAIL=

# ---------------------------------------------------------------- billing
# Plans, prices and limits are edited in Admin → Plans (stored in the database).
# Payments stay disabled until a provider below is enabled AND configured.
# Zarinpal (Iranian cards, prices in tomans). ZARINPAL_SANDBOX=true uses Zarinpal's own sandbox host.
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Stripe Checkout (international cards, prices in USD cents). Use sk_test_... keys for testing.
STRIPE_ENABLED=false
STRIPE_SECRET=
# Days before a paid period ends to send a renewal reminder (Telegram + email)
BILLING_RENEWAL_REMINDER_DAYS=3
# On account deletion, keep invoices but replace the name/email with a pseudonym
BILLING_ANONYMIZE_ON_DELETE=true
BILLING_INVOICE_PREFIX=HP
