APP_NAME="Haman Planner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: set APP_URL to the https:// address. Session cookies then become Secure automatically.
# FORCE_HTTPS=true redirects plain-HTTP page requests to HTTPS (TLS terminated at the reverse proxy).
FORCE_HTTPS=false
# Content-Security-Policy on web pages (self-hosted assets only). CSP_REPORT_ONLY=true to observe first.
CSP_ENABLED=true
CSP_REPORT_ONLY=false

APP_TIMEZONE=Asia/Tehran
# Interface language for visitors with no saved/browser preference: fa or en
APP_LOCALE=fa

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=haman_planner
DB_USERNAME=haman_planner
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

PLANNER_ADMIN_NAME=Reza
PLANNER_ADMIN_EMAIL=admin@hamantech.ir
# Strong password, 12+ chars. If omitted, APP_API_TOKEN is used only to bootstrap the first admin password.
PLANNER_ADMIN_PASSWORD=

APP_API_TOKEN=

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public sign-up on /register (true/false)
PLANNER_REGISTRATION=true
# Telegram bot username without @ (enables one-tap link button in account settings)
TELEGRAM_BOT_USERNAME=

# Mail (required for password-reset emails; Telegram-linked users also get the link in the bot)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Haman Planner"

# ---------------------------------------------------------------- business / legal
# Shown on invoices and the Privacy/Terms placeholders. Replace with your registered entity.
LEGAL_ENTITY_NAME=HamanTech
# Public contact address for privacy/support questions (defaults to MAIL_FROM_ADDRESS)
SUPPORT_EMAIL=

# ---------------------------------------------------------------- billing
# Plans, prices and limits are edited in Admin → Plans (stored in the database).
# Payments stay disabled until a provider below is enabled AND configured.
# Zarinpal (Iranian cards, prices in tomans). ZARINPAL_SANDBOX=true uses Zarinpal's own sandbox host.
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Stripe Checkout (international cards, prices in USD cents). Use sk_test_... keys for testing.
STRIPE_ENABLED=false
STRIPE_SECRET=
# Optional: webhook signing secret (whsec_...) of the endpoint https://<APP_URL>/api/billing/webhook/stripe.
# When set, Stripe checkouts become auto-renewing subscriptions (renewals/failures arrive as signed webhooks);
# without it every period is a separate one-time payment. Can also be set in Admin → Payment settings.
STRIPE_WEBHOOK_SECRET=
# Auto-renewing subscriptions: days of access after a failed renewal (provider retries), and grace for a late renewal webhook.
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_WEBHOOK_GRACE_DAYS=3
# Days before a paid period ends to send a renewal reminder (Telegram + email)
BILLING_RENEWAL_REMINDER_DAYS=3
# On account deletion, keep invoices but replace the name/email with a pseudonym
BILLING_ANONYMIZE_ON_DELETE=true
BILLING_INVOICE_PREFIX=HP

# ---------------------------------------------------------------- calendar (optional)
# Google Calendar OAuth client (Google Cloud Console → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: https://<APP_URL>/settings/calendar/google/callback. Can also be set in Admin → Integrations.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ---------------------------------------------------------------- planner
# How far ahead recurring-task occurrences are created (days)
PLANNER_RECURRENCE_HORIZON_DAYS=14
# How long an AI/planning proposal can still be applied (hours)
PLANNER_PROPOSAL_TTL_HOURS=24
# Minimum completed tasks with estimates before plan-vs-actual insights are shown
PLANNER_INSIGHTS_MIN_SAMPLES=5

# ---------------------------------------------------------------- attachments
# Storage disk for uploaded files (default: local "attachments" disk under storage/app/attachments,
# persisted by the planner_storage volume in docker-compose.prod.yml) and max upload size in KB.
ATTACHMENTS_DISK=attachments
ATTACHMENTS_MAX_KB=10240
