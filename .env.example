APP_NAME="Haman Planner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Tehran

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=haman_planner
DB_USERNAME=haman_planner
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

PLANNER_ADMIN_NAME=Reza
PLANNER_ADMIN_EMAIL=admin@hamantech.ir
# Strong password, 12+ chars. If omitted, APP_API_TOKEN is used only to bootstrap the first admin password.
PLANNER_ADMIN_PASSWORD=

APP_API_TOKEN=

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public sign-up on /register (true/false)
PLANNER_REGISTRATION=true
# Telegram bot username without @ (enables one-tap link button in account settings)
TELEGRAM_BOT_USERNAME=

# Mail (required for password-reset emails; Telegram-linked users also get the link in the bot)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Haman Planner"
